{
  "name": "eve-carbon",
  "productName": "EVE Carbon",
  "version": "3.6.0",
  "author": "Mia Christina Panayides",
  "description": "EVE Online desktop companion for industrialists: recursive blueprint calculations, live ESI wealth tracking, industry job monitoring, and integrated Jabber comms.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "demo:shots": "node scripts/demo-shots.js",
    "lint": "node scripts/lint.js",
    "esi:audit": "node scripts/esi-audit.js --list",
    "graphify:sync": "python scripts/graphify-wiki.py",
    "graphify:lint": "python scripts/graphify-wiki.py --lint",
    "hooks:install": "git config core.hooksPath .githooks",
    "watch:op": "node scripts/watch-fleet-op.js",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "test:e2e": "playwright test",
    "stress:data": "node scripts/stress-assets.js --keep",
    "stress:index": "node scripts/stress-index.js",
    "stress:render": "node scripts/stress-render.js",
    "fetch-sde": "node scripts/fetch-sde.js",
    "build-win": "npm run fetch-sde && electron-builder --win --x64",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "shots": "node scripts/shots.js"
  },
  "build": {
    "appId": "com.eve.carbon",
    "productName": "EVE-Carbon",
    "directories": {
      "buildResources": "assets"
    },
    "icon": "assets/icon.ico",
    "extraResources": [
      {
        "from": "data/",
        "to": "data/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "installerSidebar": false,
      "displayLanguageSelector": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!**/*.map",
      "!screenshots",
      "!demo-shots"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.61.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "@xmpp/client": "^0.14.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.2.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "unbzip2-stream": "^1.4.3",
    "yauzl": "^3.4.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "sqlite3@6.0.1": true
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "tar": "^7.5.21"
  }
}

{
  "name": "eve-carbon",
  "productName": "EVE Carbon",
  "version": "1.7.0",
  "author": "Mia Christina Panayides",
  "description": "EVE Online desktop companion for industrialists: recursive blueprint calculations, live ESI wealth tracking, industry job monitoring, and integrated Jabber comms.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "node scripts/lint.js",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage",
    "test:e2e": "playwright test",
    "fetch-sde": "node scripts/fetch-sde.js",
    "build-win": "npm run fetch-sde && electron-builder --win --x64",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "postinstall": "electron-builderhttps://www.netflix.com/watch/81198900?trackId=253766150&tctx=11%2C3%2C12f93fec-64a6-4534-938c-d4dd795a0eff-56779020%2CNES_8CE6A9BBA77D9B7CE37321EF1DB2D2-BDC0A082BF6430-2BB05B89F9_p_1785530409898%2CNES_8CE6A9BBA77D9B7CE37321EF1DB2D2_p_1785530409898%2C%2C%2C%2C81198900%2CVideo%3A81198900%2CminiDpPlayButton install-app-deps"
  },
  "build": {
    "appId": "com.eve.carbon",
    "productName": "EVE-Carbon",
    "directories": {
      "buildResources": "assets"
    },
    "icon": "assets/icon.ico",
    "extraResources": [
      {
        "from": "data/",
        "to": "data/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "installerSidebar": false,
      "displayLanguageSelector": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "identity": null
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!**/*.map"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.61.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@xmpp/client": "^0.14.0",
    "dotenv": "^17.4.2",
    "extract-zip": "^2.0.1",
    "js-yaml": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "unbzip2-stream": "^1.4.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "sqlite3@6.0.1": true
  },
  "overrides": {
    "brace-expansion": "^5.0.7"
  }
}
